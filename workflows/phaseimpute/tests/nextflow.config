process {
    withName: SHAPEIT5_PHASECOMMON {
        cpus = 1
        ext.args = "--seed 1"
        ext.suffix = "bcf"
        ext.prefix = { "${meta.id}_${meta.chunk.replace(':',"_")}_chunks" }
    }

    withName: STITCH {
        cpus  = 1
        cache = "lenient"
        ext.prefix = { "${meta.id}.batch${meta.batch}.${meta.chr}.stitch" }
    }

    withName: QUILT_QUILT {
        cpus       = 1
        ext.args   = "--seed=1"
        ext.prefix = { "${meta.id}.batch${meta.batch}.${meta.chunk.replace(':','_')}.quilt" }
        publishDir = [enabled: false]
    }

    withName: GLIMPSE2_PHASE {
        cpus       = 1
        cache = "lenient"
        ext.prefix   = { "${meta.id}.batch${meta.batch}.${meta.chunk.replace(':','_')}.glimpse2" }
        ext.args     = { "--keep-monomorphic-ref-sites --seed ${params.seed}" }
        ext.suffix   = "bcf"
        publishDir   = [ enabled: false ]
    }
}
