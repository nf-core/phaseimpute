process {
    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:VCF_IMPUTE_BEAGLE5:BEAGLE5_BEAGLE' {
        ext.prefix = { "${meta.id}.batch${meta.batch}.${meta.chr}.beagle5" }
        publishDir = [ enabled: false ]
    }

    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:VCF_IMPUTE_BEAGLE5:BCFTOOLS_INDEX_IMPUTE' {
        ext.args   = "--csi"
        publishDir = [ enabled: false ]
    }
}
