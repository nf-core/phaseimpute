/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Shared config for prephase step preprocessing
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    // Prephase vcf files with shapeit5
    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:VCF_PHASE_TARGET:.*' {
        tag = {"${meta.id} ${meta.regionout ?: meta.chr}"}
    }

    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:VCF_PHASE_TARGET:SHAPEIT5_PHASECOMMON' {
        ext.args = {"--seed ${params.seed}"}
        ext.suffix = "bcf"
        ext.prefix = { "${meta.id}_${meta.regionout.replace(':',"_")}_chunks" }
        publishDir = [
            path: { "${params.outdir}/prephasing/chunks" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all
        ]
    }

    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:VCF_PHASE_TARGET:BCFTOOLS_INDEX_PHASE' {
        ext.prefix = { "${meta.id}_${meta.regionout.replace(':',"_")}_chunks" }
        ext.args   = "--csi"
        publishDir = [
            path: { "${params.outdir}/prephasing/chunks" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all
        ]
    }

    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:VCF_PHASE_TARGET:SHAPEIT5_LIGATE' {
        ext.args = {"--seed ${params.seed}"}
        ext.prefix = { "${meta.id}_${meta.chr}_phased" }
        publishDir = [
            path: { "${params.outdir}/prephasing/ligate" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }

    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:VCF_PHASE_TARGET:BCFTOOLS_INDEX_LIGATE' {
        ext.prefix = { "${meta.id}_${meta.chr}_phased" }
        ext.args   = "--csi"
        publishDir = [
            path: { "${params.outdir}/prephasing/ligate" },
            mode: params.publish_dir_mode,
            enabled: true
        ]
    }

    // Concatenate the prephased chunks
    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:CONCAT_PREPHASE:.*' {
        publishDir = [
            path: { "${params.outdir}/prephasing/concat" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:CONCAT_PREPHASE:BCFTOOLS_CONCAT' {
        ext.args = "--output-type z --ligate"
        ext.prefix = { "${meta.id}${meta.batch ? ".batch${meta.batch}" : "" }.prephase" }
        publishDir = [ enabled: false ]
    }

    withName: 'NFCORE_PHASEIMPUTE:PHASEIMPUTE:CONCAT_PREPHASE:HTSLIB_BGZIPTABIX' {
        ext.prefix = { "${meta.id}${meta.batch ? ".batch${meta.batch}" : "" }.prephase" }
    }
}
