nextflow_process {

    name "Test Process MAPCONVERT"
    script "../main.nf"
    process "MAPCONVERT"

    tag "modules"
    tag "modules_local"
    tag "mapconvert"
    tag "gawk"

    test("Convert map with pos\\tchr\\tcm (glimpse format)") {
        when {
            process {
                """
                def file = Channel.fromPath("${moduleDir}/tests/resources/pos_chr_cm_tab_header.map.gz")
                input[0] = Channel.of([[id: "test", chr: "chr1"]]).combine(file)
                input[1] = '\\t'
                input[2] = 'true'
                input[3] = 'pos,chr,cm'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    path(process.out.stitch_map[0][1]).readLines()
                ).match() }
            )
        }
    }

    test("Convert map with pos\tchr\tcm (glimpse format)") {
        when {
            process {
                """
                def file = Channel.fromPath("${moduleDir}/tests/resources/pos_chr_cm_tab_header.map.gz")
                input[0] = Channel.of([[id: "test", chr: "chr1"]]).combine(file)
                input[1] = '\t'
                input[2] = 'true'
                input[3] = 'pos,chr,cm'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    path(process.out.stitch_map[0][1]).readLines()
                ).match() }
            )
        }
    }

    test("Convert map with pos cm") {

        when {
            process {
                """
                def file = Channel.fromPath("${moduleDir}/tests/resources/pos_cm_space_noheader.map")
                input[0] = Channel.of([[id: "test", chr: "chr1"]]).combine(file)
                input[1] = ' '
                input[2] = 'false'
                input[3] = 'pos,cm'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    path(process.out.stitch_map[0][1]).readLines()
                ).match() }
            )
        }
    }

    test("Convert map with chr id cm pos (plink format)") {

        when {
            process {
                """
                def file = Channel.fromPath("${moduleDir}/tests/resources/chr_id_cm_pos_space_noheader.map")
                input[0] = Channel.of([[id: "test", chr: "chr1"]]).combine(file)
                input[1] = ' '
                input[2] = 'false'
                input[3] = 'chr,id,cm,pos'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    path(process.out.stitch_map[0][1]).readLines()
                ).match() }
            )
        }
    }

    test("Convert map with pos rate cm (stitch format)") {
        when {
            process {
                """
                def file = Channel.fromPath("${moduleDir}/tests/resources/pos_rate_cm_space_header.map")
                input[0] = Channel.of([[id: "test", chr: "chr1"]]).combine(file)
                input[1] = ' '
                input[2] = 'true'
                input[3] = 'pos,rate,cm'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    path(process.out.stitch_map[0][1]).readLines()
                ).match() }
            )
        }
    }

    test("Convert map with chr id cm pos (plink format) distant") {
        when {
            process {
                """
                input[0] = Channel.of([
                    [id: "test", chr: "chr22"],
                    file(params.pipelines_testdata_base_path + "hum_data/reference_genome/GRCh38_chr22.plink.map", checkIfExist:true)
                ])
                input[1] = ' '
                input[2] = 'false'
                input[3] = 'chr,id,pos,cm'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.versions,
                    process.out.stitch_map
                ).match() }
            )
        }
    }

    test("Test error chr not corresponding") {
        when {
            process {
                """
                def file = Channel.fromPath("${moduleDir}/tests/resources/pos_chr_cm_tab_header.map.gz")
                input[0] = Channel.of([[id: "test", chr: "chr2"]]).combine(file)
                input[1] = '\\t'
                input[2] = 'true'
                input[3] = 'pos,chr,cm'
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Error: Chromosome mismatch") }
            )
        }
    }

    test("Test error missing pos") {
        when {
            process {
                """
                def file = Channel.fromPath("${moduleDir}/tests/resources/pos_cm_space_noheader.map")
                input[0] = Channel.of([[id: "test", chr: "chr1"]]).combine(file)
                input[1] = ' '
                input[2] = 'false'
                input[3] = 'chr,cm'
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Error: Position and cM missing") }
            )
        }
    }

    test("Test error missing cm") {
        when {
            process {
                """
                def file = Channel.fromPath("${moduleDir}/tests/resources/pos_rate_cm_space_header_error.map")
                input[0] = Channel.of([[id: "test", chr: "chr1"]]).combine(file)
                input[1] = ' '
                input[2] = 'true'
                input[3] = 'pos,rate,cm'
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Error: Position and cM missing") }
            )
        }
    }

    test("Test stub") {
        options "-stub"
        when {
            process {
                """
                def file = Channel.fromPath("${moduleDir}/tests/resources/pos_rate_cm_space_header_error.map")
                input[0] = Channel.of([[id: "test", chr: "chr1"]]).combine(file)
                input[1] = ' '
                input[2] = 'true'
                input[3] = 'pos,rate,cm'
                """
            }
        }

        then {
            assert snapshot(
                process.out
            ).match()
        }
    }
}
