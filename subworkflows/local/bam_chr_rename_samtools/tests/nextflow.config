params {
    max_memory = '2.GB'
}

process {
    withName: 'BAM_CHR_RENAME_SAMTOOLS:SAMTOOLS_REHEADER' {
        ext.args   = { "-c ${meta.samtools_reheader_cmd}" }
        ext.prefix = { "${meta.id}_withchr" }
    }
    withName: 'PREPROCESS:SAMTOOLS_REHEADER' {
        ext.args   = { "-c ${meta.samtools_reheader_cmd}" }
        ext.prefix = { "${meta.id}_nochr" }
    }
}
