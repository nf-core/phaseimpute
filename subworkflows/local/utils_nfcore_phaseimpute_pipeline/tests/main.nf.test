nextflow_workflow {

    name "Test Workflow PIPELINE_INITIALISATION"
    script "../main.nf"
    workflow "PIPELINE_INITIALISATION"
    tag 'subworkflows'
    tag 'utils_nfcore_phaseimpute_pipeline'
    tag 'subworkflows/utils_nfcore_phaseimpute_pipeline'

    test("Should run with no error") {
        when {
            workflow {
                """
                input[0] = false // version
                input[1] = false // validate_params
                input[2] = false // _monochrome_logs
                input[3] = [] // nextflow_cli_args
                input[4] = "results" // outdir
                input[5] = [] // help
                input[6] = [] // help_full
                input[7] = [] // show_hidden
                input[8] = channel.of([
                    [genome: "GRCh38"],
                    file(params.pipelines_testdata_base_path + "/hum_data/reference_genome/GRCh38.s.fa.gz", checkIfExists: true),
                    file(params.pipelines_testdata_base_path + "/hum_data/reference_genome/GRCh38.s.fa.gz.fai", checkIfExists: true),
                    file(params.pipelines_testdata_base_path + "/hum_data/reference_genome/GRCh38.s.fa.gz.gzi", checkIfExists: true)
                ]) // ch_ref_gen
                input[9] =  [
                    "input_target" : null,
                    "input_truth"  : null,
                    "input_region" : null,
                    "input_panel"  : "../../../tests/csv/panel.csv",
                    "input_posfile": "../../../tests/csv/posfile.csv",
                    "input_chunks" : "../../../tests/csv/chunks.csv",
                    "input_map"    : "../../../tests/csv/map_glimpse.csv",
                ]
                input[10] = ["panelprep"] // steps
                input[11] = [] // tools
                input[12] = null // batch_size
                input[13] = 5 // max_chr_names
                input[14] = null // depth
                input[15] = null // genotype
                input[16] = null // remove_samples
                input[17] = null // normalize
                input[18] = "recursive" // chunk_model
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }

    test("Should give a warning all file given") {
        when {
            workflow {
                """
                input[0] = false // version
                input[1] = false // validate_params
                input[2] = false // _monochrome_logs
                input[3] = [] // nextflow_cli_args
                input[4] = "results" // outdir
                input[5] = [] // help
                input[6] = [] // help_full
                input[7] = [] // show_hidden
                input[8] = channel.of([
                    [genome: "GRCh38"],
                    file(params.pipelines_testdata_base_path + "/hum_data/reference_genome/GRCh38.s.fa.gz", checkIfExists: true),
                    file(params.pipelines_testdata_base_path + "/hum_data/reference_genome/GRCh38.s.fa.gz.fai", checkIfExists: true),
                    file(params.pipelines_testdata_base_path + "/hum_data/reference_genome/GRCh38.s.fa.gz.gzi", checkIfExists: true)
                ]) // ch_ref_gen
                input[9] = [
                    "input_target" : null,
                    "input_truth"  : null,
                    "input_region" : "$moduleTestDir/region.csv",
                    "input_panel"  : "../../../tests/csv/panel.csv",
                    "input_posfile": "../../../tests/csv/posfile.csv",
                    "input_chunks" : "../../../tests/csv/chunks.csv",
                    "input_map"    : "../../../tests/csv/map_glimpse.csv",
                ]
                input[10] = ["panelprep"] // steps
                input[11] = [] // tools
                input[12] = null // batch_size
                input[13] = 5 // max_chr_names
                input[14] = null // depth
                input[15] = null // genotype
                input[16] = null // remove_samples
                input[17] = null // normalize
                input[18] = "sequential" // chunk_model
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.stdout.contains("WARN: The following contigs are absent from at least one file : [chr2] and therefore won't be used")}
            )
        }
    }

    test("Should give a warning with missing files") {
        when {
            workflow {
                """
                input[0] = false // version
                input[1] = false // validate_params
                input[2] = false // _monochrome_logs
                input[3] = [] // nextflow_cli_args
                input[4] = "results" // outdir
                input[5] = [] // help
                input[6] = [] // help_full
                input[7] = [] // show_hidden
                input[8] = channel.of([
                    [genome: "GRCh38"],
                    file(params.pipelines_testdata_base_path + "/hum_data/reference_genome/GRCh38.s.fa.gz", checkIfExists: true),
                    file(params.pipelines_testdata_base_path + "/hum_data/reference_genome/GRCh38.s.fa.gz.fai", checkIfExists: true),
                    file(params.pipelines_testdata_base_path + "/hum_data/reference_genome/GRCh38.s.fa.gz.gzi", checkIfExists: true)
                ]) // ch_ref_gen
                input[9] = [
                    "input_target" : null,
                    "input_truth"  : null,
                    "input_region" : "$moduleTestDir/region.csv",
                    "input_panel"  : "../../../tests/csv/panel.csv",
                    "input_posfile": null,
                    "input_chunks" : "../../../tests/csv/chunks.csv",
                    "input_map"    : null,
                ]
                input[10] = ["panelprep"] // steps
                input[11] = [] // tools
                input[12] = null // batch_size
                input[13] = 5 // max_chr_names
                input[14] = null // depth
                input[15] = null // genotype
                input[16] = null // remove_samples
                input[17] = null // normalize
                input[18] = "recursive" // chunk_model
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.stdout.contains("WARN: The following contigs are absent from at least one file : [chr2] and therefore won't be used")}
            )
        }
    }

    test("Should give an error due to multiple panel_id") {
        when {
            workflow {
                """
                input[0] = false // version
                input[1] = false // validate_params
                input[2] = false // _monochrome_logs
                input[3] = [] // nextflow_cli_args
                input[4] = "results" // outdir
                input[5] = [] // help
                input[6] = [] // help_full
                input[7] = [] // show_hidden
                input[8] = channel.of([
                    [genome: "GRCh38"],
                    file(params.pipelines_testdata_base_path + "/hum_data/reference_genome/GRCh38.s.fa.gz", checkIfExists: true),
                    file(params.pipelines_testdata_base_path + "/hum_data/reference_genome/GRCh38.s.fa.gz.fai", checkIfExists: true),
                    file(params.pipelines_testdata_base_path + "/hum_data/reference_genome/GRCh38.s.fa.gz.gzi", checkIfExists: true)
                ]) // ch_ref_gen
                input[9] = [
                    "input_target" : null,
                    "input_truth"  : null,
                    "input_region" : null,
                    "input_panel"  : "../../../tests/csv/panel_multiple.csv",
                    "input_posfile": "../../../tests/csv/posfile.csv",
                    "input_chunks" : "../../../tests/csv/chunks.csv",
                    "input_map"    : "../../../tests/csv/map_glimpse.csv",
                ]
                input[10] = ["panelprep"] // steps
                input[11] = [] // tools
                input[12] = null // batch_size
                input[13] = 5 // max_chr_names
                input[14] = null // depth
                input[15] = null // genotype
                input[16] = null // remove_samples
                input[17] = null // normalize
                input[18] = "recursive" // chunk_model
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.errorMessage.contains("Multiple panel IDs detected: [1000GP, 1000GP_2]. Please provide only one across panel, chunks and posfile.")}
            )
        }
    }
}
