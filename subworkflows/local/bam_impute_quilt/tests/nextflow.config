process {

    resourceLimits = [
        cpus: 4,
        memory: '2.GB',
        time: '6.h'
    ]

    // Impute quilt
    withName: QUILT_QUILT {
        cpus       = 1
        ext.args   = "--seed=1"
        ext.prefix = { "${meta.id}_${meta.chunk.replace(':','_')}.impute" }
        publishDir = [enabled: false]
    }

    // Annotate quilt imputed VCFs
    withName: BCFTOOLS_ANNOTATE {
        ext.args     = ["--set-id '%CHROM:%POS:%REF:%ALT'", "-Oz", "--write-index=tbi"].join(' ')
        ext.prefix = { "${meta.id}_${meta.chunk.replace(':','_')}.impute.annotate" }
        publishDir = [ enabled: false ]
    }
}
