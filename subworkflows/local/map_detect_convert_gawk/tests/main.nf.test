nextflow_workflow {

    name "Test Subworkflow MAP_DETECT_CONVERT_GAWK"
    script "../main.nf"
    workflow "MAP_DETECT_CONVERT_GAWK"

    tag "modules"
    tag "modules_local"
    tag "mapautodetect"
    tag "mapconvert"
    tag "gawk"

    test("All files auto detect and convert") {
        when {
            workflow {
                """
                input[0] = channel.of([
                    [id: "pos_chr_cm_tab_header.map.gz", chr: "chr1"],
                    file("${moduleDir}/tests/resources/pos_chr_cm_tab_header.map.gz", checkIfExists: true)
                ],[
                    [id: "chr_id_cm_pos_space_noheader.map", chr: "chr1"],
                    file("${moduleDir}/tests/resources/chr_id_cm_pos_space_noheader.map", checkIfExists: true)
                ],[
                    [id: "pos_rate_cm_space_header.map", chr: "chr1"],
                    file("${moduleDir}/tests/resources/pos_rate_cm_space_header.map", checkIfExists: true)
                ],[
                    [id: "rate_pos_cm_comma_header.map", chr: "chr1"],
                    file("${moduleDir}/tests/resources/rate_pos_cm_comma_header.map", checkIfExists: true)
                ],[
                    [id: "GRCh38_chr22.plink.map", chr: "chr22"],
                    file(params.pipelines_testdata_base_path + "hum_data/reference_genome/GRCh38_chr22.plink.map", checkIfExist:true)
                ])
                input[1] = []
                input[2] = []
                input[3] = []
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    sanitizeOutput(workflow.out),
                    path(workflow.out.map_stitch[1][1]).readLines()
                ).match() }
            )
        }
    }

    test("Auto detect map with pos cm, no header -- no error") {

        when {
            workflow {
                """
                def file = channel.fromPath("${moduleDir}/tests/resources/pos_cm_space_noheader.map")
                input[0] = channel.of([[id: "test", chr: "chr1"]]).combine(file)
                input[1] = []
                input[2] = []
                input[3] = "pos,cm"
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    sanitizeOutput(workflow.out),
                    path(workflow.out.map_stitch[0][1]).readLines()
                ).match() }
            )
        }
    }

    test("Test stub") {
        options "-stub"
        when {
            workflow {
                """
                def file = channel.fromPath("${moduleDir}/tests/resources/pos_rate_cm_space_header_error.map")
                input[0] = channel.of([[id: "test", chr: "chr1"]]).combine(file)
                input[1] = []
                input[2] = 'false'
                input[3] = []
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(sanitizeOutput(workflow.out)).match()
        }
    }
}
