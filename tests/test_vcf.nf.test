def projectDir = new File('.').absolutePath

nextflow_pipeline {

    name "Test phaseimpute workflow"
    script "../main.nf"
    tag "pipeline"
    tag "pipeline/phaseimpute"
    tag "test_vcf"

    def test_scenario = [
        [
            name: "Check test_vcf - 3 vcf and 3 samples",
            config: "../conf/test_vcf.config",
            params: [
                input: "${projectDir}/tests/csv/sample_3vcf3samples.csv",
                force_multi_vcf: true
            ]
        ],
        [
            name: "Check test_vcf - 1 vcf and 3 samples",
            config: "../conf/test_vcf.config",
            params: [
                input: "${projectDir}/tests/csv/sample_1vcf3samples.csv"
            ]
        ],
        [
            name: "Check test_vcf - 3 vcf and 3 samples - error",
            config: "../conf/test_vcf.config",
            params: [
                input: "${projectDir}/tests/csv/sample_3vcf3samples.csv",
                force_multi_vcf: false
            ],
            result: "failed"
        ]
    ]

    test_scenario.each { scenario ->
        test(scenario.name, UTILS.getPhaseimputeTest(scenario))
    }
}
